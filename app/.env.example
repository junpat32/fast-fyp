# Copy to app/.env for live mode (sign-in, your own data); leave app/.env out (or empty) for sample data.
# All three or none (api/config.ts). These are bundled into the app, so ONLY public values go here (rule 7):
# never the service_role / secret key, never the Groq key. After a change: npx expo start -c

# Supabase: Project Settings -> Data API -> Project URL (https://....supabase.co); the same as SUPABASE_URL in .env
EXPO_PUBLIC_SUPABASE_URL=
# Supabase: Project Settings -> API Keys -> the anon / publishable key; the same as SUPABASE_ANON_KEY in .env
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The API: https://fast-api-....onrender.com, or before Render this laptop on the phone's hotspot,
# e.g. http://192.168.43.20:8000 while "python -m uvicorn api.main:app --host 0.0.0.0 --port 8000" runs
EXPO_PUBLIC_API_URL=
