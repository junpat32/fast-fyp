# Copy to .env (never commit .env; it is in .gitignore). Real values come from the Supabase dashboard.

# Backend (api/) and live RLS test
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only if the project still uses the legacy JWT secret (HS256); leave empty with JWT signing keys
SUPABASE_JWT_SECRET=
RATE_LIMIT_PER_MINUTE=60

# Public "anon"/publishable key: safe in the app, RLS protects the data. The backend sends it with
# the user's own token to read and write the game's facts (/v1/game)
SUPABASE_ANON_KEY=

# The money helper (POST /v1/assistant, T-17). A SECRET: from console.groq.com -> API Keys. Only the
# backend reads it; never put it in the app (no EXPO_PUBLIC_ prefix). Also used by
# tools/assistant_eval/run.py (the red-team run)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ASSISTANT_DAILY_LIMIT=30

# Two TEST users for tests/test_rls.py (made-up emails, synthetic data only)
RLS_TEST_A_EMAIL=
RLS_TEST_A_PASSWORD=
RLS_TEST_B_EMAIL=
RLS_TEST_B_PASSWORD=

# NEVER put the service_role key in the app or the backend; admin scripts only (CLAUDE.md rule 8)
